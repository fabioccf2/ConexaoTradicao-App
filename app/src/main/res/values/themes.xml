<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ConexaoTradicao" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/coffee_brown</item>
        <item name="colorPrimaryVariant">@color/coffee_brown_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/moss_green</item>
        <item name="colorSecondaryVariant">@color/moss_green_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <item name="android:statusBarColor">@color/coffee_brown</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <style name="Theme.ConexaoTradicao.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="TextAppearance.ConexaoTradicao.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/coffee_brown</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.ConexaoTradicao.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.ConexaoTradicao.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/coffee_brown</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.ConexaoTradicao.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/moss_green</item>
        <item name="android:textColor">@color/moss_green_dark</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.ConexaoTradicao.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>
</resources>
