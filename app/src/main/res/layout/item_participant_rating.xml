<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/participant_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.ConexaoTradicao.Body"
        tools:text="Fabiano Tiger" />

    <!-- Já avaliado por esse produtor (RF10) — some o botão, mostra só a confirmação. -->
    <TextView
        android:id="@+id/participant_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/moss_green_dark"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Avaliado ✓"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_rate_participant"
        style="@style/Widget.ConexaoTradicao.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="12dp"
        android:text="@string/btn_rate" />

</LinearLayout>
